# auto uses Groq when GROQ_API_KEY is set, otherwise local fallback
CLASSIFIER_PROVIDER=auto
# CLASSIFIER_PROVIDER=groq
# CLASSIFIER_PROVIDER=local
# GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile
POLICIES_PATH=config/policies.json
MODERATION_PROMPT_PATH=config/moderation_prompt.md
MODERATION_DB_PATH=moderation.db
REDIS_HOST=localhost
REDIS_PORT=6379
QUEUE_NAME=moderation_queue
