# =================================
# DATABASE (Supabase)
# =================================
# Get this from your Supabase project: Settings -> Database -> Connection string -> URI
SUPABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# =================================
# AI (Groq)
# =================================
# Get this from your GroqCloud dashboard: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"

# =================================
# EMAIL CONFIGURATION (Resend HTTP API)
# =================================
# Resend sends over HTTPS (443), so it works on Render where SMTP ports are blocked.
# Get an API key from https://resend.com/api-keys (starts with "re_")
RESEND_API_KEY="re_your_resend_api_key_here"

# The "From" address. Use "onboarding@resend.dev" for testing (delivers ONLY to
# your Resend signup email). For arbitrary recipients, verify a domain in Resend
# and use an address on it, e.g. "alerts@yourdomain.com".
RESEND_FROM="onboarding@resend.dev"

# =================================
# REDIS CONFIGURATION
# =================================
# Hostname or IP address of your Redis server (default: localhost)
REDIS_HOST="localhost"

# Port number for your Redis server (default: 6379)
REDIS_PORT="6379"

# Password for your Redis server, if applicable (leave empty if none)
REDIS_PASSWORD="your_redis_default_password"

# Name of the queue used for moderation tasks (default: moderation_queue)
QUEUE_NAME="moderation_queue"